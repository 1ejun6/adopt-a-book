{
  "name": "adopt-a-book",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "run-p dev:server dev:client",
    "dev:server": "cd server && pnpm run dev",
    "dev:client": "cd client && pnpm run dev",
    "build": "cd client && pnpm run build",
    "test:e2e": "cd client && pnpm run test:e2e",
    "format": "cd client && pnpm run format",
    "lint": "run-s lint:server lint:client",
    "lint:server": "eslint \"server/**/*.js\" --no-error-on-unmatched-pattern",
    "lint:client": "cd client && pnpm run lint",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{js,vue}": "eslint"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.11.0",
    "eslint-plugin-vue": "^10.11.0",
    "globals": "^17.12.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1",
    "npm-run-all2": "^9.0.3"
  }
}
